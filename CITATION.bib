@article{CONTRERAS2026123192,
  title        = {Probabilistic serviceability assessment of footbridges subjected to crowd-induced lateral vibrations},
  journal      = {Engineering Structures},
  volume       = {366},
  pages        = {123192},
  year         = {2026},
  issn         = {0141-0296},
  doi          = {10.1016/j.engstruct.2026.123192},
  url          = {https://www.sciencedirect.com/science/article/pii/S0141029626011065},
  author       = {Alexis Contreras and Gaston Fermandois and Pablo Heresi},
  keywords     = {Footbridges, Serviceability, Lateral vibrations, Human–structure interaction, Foot force, van der Pol oscillators, Uncertainty, Damping, Fragility},
  abstract     = {Lightweight and flexible footbridges are increasingly susceptible to large lateral excitations induced by pedestrians. Current research typically relies on deterministic estimates of critical crowd sizes, which often neglect behavioral uncertainties and utilize simplified single-degree-of-freedom (SDOF) models. To address these limitations, this study proposes a probabilistic framework to estimate the likelihood of exceeding lateral serviceability limit states. The methodology employs an equivalent beam model to account for spatial variations as pedestrians traverse the span, avoiding the limitations of fixed-point oscillating load models. A novel foot-force model based on gait stability is developed and validated against experimental data. Monte Carlo simulations are then used to propagate parametric uncertainties and generate fragility curves and surfaces. Case studies on various bridges reveal that serviceability performance is significantly more sensitive to bridge frequency than damping, particularly when the bridge frequency avoids the mean pedestrian gait frequency. Additionally, a procedure for estimating maximum occupancy limits is introduced to ensure operational reliability. This work introduces a formal reliability-analysis procedure, providing designers with essential tools to probabilistically assess performance objectives and ensure compliance with serviceability requirements.}
}
